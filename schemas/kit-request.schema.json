{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbe.dev/exterior/kit-request.schema.json",
  "title": "Exterior kit assembly request",
  "description": "Input to planAssembly and assembleFromPieces. Parcel and building use the per parcel request fields. The footprint is a CCW rectangle with edges of 8N metres, N at least two. Floors number at least two. Authored band heights including the crown cap must fit maxHeight. Basements are zero. Outputs retain the parcel frame and edge order. Custom heights require matching custom pieces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "buildingId"
  ],
  "properties": {
    "family": {
      "$ref": "kit.schema.json#/$defs/familyId"
    },
    "buildingId": {
      "$ref": "building-request.schema.json#/properties/buildingId"
    },
    "seed": {
      "$ref": "building-request.schema.json#/properties/seed",
      "description": "Defaults to buildingId."
    },
    "theme": {
      "$ref": "building-request.schema.json#/properties/theme",
      "default": "cyberpunk"
    },
    "parcel": {
      "$ref": "building-request.schema.json#/properties/parcel",
      "properties": {
        "footprint": {
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "building": {
      "$ref": "building-request.schema.json#/properties/building",
      "properties": {
        "floors": {
          "minimum": 2
        },
        "basements": {
          "const": 0
        }
      }
    },
    "lot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "depth"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 16,
          "multipleOf": 8
        },
        "depth": {
          "type": "number",
          "minimum": 16,
          "multipleOf": 8
        }
      },
      "description": "Legacy origin at zero lot size. Use with floors instead of parcel and building."
    },
    "floors": {
      "type": "integer",
      "minimum": 2,
      "description": "Legacy floor count used with lot."
    },
    "entranceEdge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Parcel edge override. Defaults to the street facing edge nearest accessPoint, or edge zero for lot requests."
    },
    "groundHeight": {
      "type": "number",
      "minimum": 2.2,
      "maximum": 12,
      "description": "Ground band height, recipe default when omitted."
    },
    "floorHeight": {
      "type": "number",
      "minimum": 2.2,
      "maximum": 12,
      "description": "Middle band height, recipe default when omitted. Crown adds its authored cap and must also stay within twelve metres."
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "edge",
          "u",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "edge": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "u": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "description": "Wire anchors in parcel face coordinates. u follows the edge, y is absolute elevation."
    }
  },
  "oneOf": [
    {
      "required": [
        "parcel",
        "building"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "lot"
            ]
          },
          {
            "required": [
              "floors"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "lot",
        "floors"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "parcel"
            ]
          },
          {
            "required": [
              "building"
            ]
          }
        ]
      }
    }
  ]
}
