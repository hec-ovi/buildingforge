{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:exterior-native-finishes",
  "title": "Native exterior finish bindings",
  "type": "object",
  "required": [
    "version",
    "surfaces",
    "palettes",
    "styles"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "surfaces": {
      "$ref": "#/$defs/surfaceBindings"
    },
    "palettes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/paletteId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/surfaceBindings"
      }
    },
    "styles": {
      "type": "object",
      "required": [
        "residential-salvaged",
        "residential-weathered",
        "residential-modest",
        "premium-obsidian",
        "premium-office",
        "premium-mineral",
        "civic-utility",
        "civic-institutional",
        "civic-industrial"
      ],
      "propertyNames": {
        "enum": [
          "residential-salvaged",
          "residential-weathered",
          "residential-modest",
          "premium-obsidian",
          "premium-office",
          "premium-mineral",
          "civic-utility",
          "civic-institutional",
          "civic-industrial"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/paletteId"
        }
      }
    }
  },
  "$defs": {
    "glbFinish": {
      "type": "object",
      "required": [
        "key",
        "variantId"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^cyberpunk/exterior-[a-z-]+/mid$"
        },
        "variantId": {
          "const": "native"
        },
        "paletteId": {
          "$ref": "#/$defs/paletteId"
        }
      }
    },
    "surfaceBindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+(#[a-z0-9_-]+)?$"
      },
      "additionalProperties": {
        "enum": [
          "cast-concrete",
          "weathered-concrete",
          "mineral-concrete",
          "graphite-concrete",
          "galvanized-steel",
          "graphite-coating",
          "ac-enamel",
          "ac-coil",
          "board-concrete",
          "aggregate-concrete",
          "basalt-concrete",
          "brushed-bronze",
          "brushed-steel",
          "chalk-coating"
        ]
      }
    },
    "paletteId": {
      "enum": [
        "slate",
        "formed",
        "aggregate",
        "chalk",
        "bronze",
        "steel"
      ]
    }
  }
}
