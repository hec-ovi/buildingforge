{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-attachment.schema.json",
  "title": "Exterior antenna cable attachment",
  "description": "Stable building-local attachment available to a downstream interbuilding cable fitter. Position and normal use the exterior world frame; clearanceRadius is reserved in the roof plane from unrelated equipment.",
  "oneOf": [
    {
      "type": "object",
      "required": ["id", "position", "orientation", "clearanceRadius"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/point3" },
        "orientation": { "const": "omnidirectional" },
        "clearanceRadius": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    {
      "type": "object",
      "required": ["id", "position", "orientation", "normal", "clearanceRadius"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/point3" },
        "orientation": { "const": "directional" },
        "normal": {
          "$ref": "#/$defs/point3",
          "description": "Horizontal unit direction in which a fitted cable leaves the attachment."
        },
        "clearanceRadius": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  ],
  "$defs": {
    "point3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
