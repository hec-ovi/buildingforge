{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/exterior/blueprint",
  "title": "Blueprint",
  "description": "Exterior shell blueprint, the canonical schema (interior consumes the floors core). Units: meters. Same coordinate frame as the request footprint, right-handed, +Y up, floor outlines on the XZ plane, CCW winding, first point not repeated.",
  "type": "object",
  "required": ["buildingId", "seed", "bounds", "floors", "balconyBands", "roof", "materials"],
  "additionalProperties": false,
  "properties": {
    "buildingId": { "type": "string" },
    "seed": { "type": "string" },
    "bounds": {
      "type": "object",
      "required": ["footprint", "height"],
      "additionalProperties": false,
      "properties": {
        "footprint": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point2" },
          "description": "ground-floor outline actually built (within the parcel footprint)"
        },
        "height": { "type": "number", "exclusiveMinimum": 0, "description": "top of parapet above Y=0" }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "kind", "elevation", "height", "outline", "openings"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "description": "0 = ground floor, contiguous; negative = basement" },
          "kind": { "type": "string", "description": "atlas type verbatim for typed floors (residential, hotel, offices, corpo, hospital, clinic, police, military, factory, commerce, mall, restaurant, coffee_shop) plus lobby, entry, basement, bar, executive; request floorKinds pass through unchanged" },
          "elevation": { "type": "number", "description": "Y of this floor's walking surface" },
          "height": { "type": "number", "minimum": 2.2, "maximum": 12, "description": "floor-to-floor distance" },
          "outline": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/point2" },
            "description": "CCW simple polygon of the floor plate, [x, z]"
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "edge", "offset", "width", "height", "sill"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "kind": { "enum": ["door", "window", "balconyDoor", "openFront", "aperture"] },
                "edge": { "type": "integer", "minimum": 0, "description": "outline edge index (vertex i to i+1)" },
                "offset": { "type": "number", "minimum": 0, "description": "meters along the edge to the opening's start" },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "sill": { "type": "number", "minimum": 0, "description": "bottom of opening above floor surface" },
                "apertureKind": { "enum": ["bridge", "ac-tube", "tunnel"], "description": "present when kind = aperture; id echoes the request aperture id" },
                "state": { "enum": ["open", "half", "closed80"], "description": "vertical curtain state, windows and balcony doors only" },
                "leaves": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4,
                  "description": "door and balconyDoor: swinging leaves; the GLB carries one node subtree per leaf, hinged on its own pivot"
                },
                "door": {
                  "type": "object",
                  "required": ["set", "frameWidth", "frameDepth", "recessDepth", "thresholdHeight", "motion"],
                  "additionalProperties": false,
                  "description": "present exactly on door and balconyDoor: the coordinated visible set, fixed frame dimensions and movement envelope",
                  "properties": {
                    "set": { "enum": ["plain", "layered", "glazed-grid", "industrial-ribbed", "illuminated"] },
                    "frameWidth": { "type": "number", "exclusiveMinimum": 0 },
                    "frameDepth": { "type": "number", "exclusiveMinimum": 0 },
                    "recessDepth": { "type": "number", "minimum": 0 },
                    "thresholdHeight": { "type": "number", "minimum": 0 },
                    "motion": {
                      "type": "object",
                      "required": ["kind", "maxTravel", "clearDepth"],
                      "additionalProperties": false,
                      "properties": {
                        "kind": { "enum": ["swing", "roller"] },
                        "maxTravel": { "type": "number", "minimum": 0, "description": "degrees for swing, meters for roller" },
                        "clearDepth": { "type": "number", "minimum": 0, "description": "depth reserved behind the threshold for movement" }
                      }
                    }
                  }
                },
                "doorRole": {
                  "enum": ["main", "secondary", "service"],
                  "description": "door only: main street entrance, repeated public entrance, or service/loading access; interior and navigation consumers connect every published role"
                },
                "portal": {
                  "type": "object",
                  "required": ["frameWidth", "frameDepth", "recessDepth", "clearWidth", "clearHeight", "clearDepth"],
                  "additionalProperties": false,
                  "description": "openFront only: fixed surround and traversable dimensions of the permanently open street connection",
                  "properties": {
                    "frameWidth": { "type": "number", "exclusiveMinimum": 0 },
                    "frameDepth": { "type": "number", "exclusiveMinimum": 0 },
                    "recessDepth": { "type": "number", "exclusiveMinimum": 0 },
                    "clearWidth": { "type": "number", "exclusiveMinimum": 0 },
                    "clearHeight": { "type": "number", "exclusiveMinimum": 0 },
                    "clearDepth": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                "accessRole": {
                  "const": "main",
                  "description": "openFront only: primary navigation connection supplied without a moving door"
                },
                "transom": {
                  "type": "number",
                  "minimum": 0,
                  "description": "door only: glazed transom light carried above the head, part of this opening; it starts 0.15 m above the door head and belongs to the door's run of the edge"
                },
                "head": {
                  "type": "number",
                  "minimum": 0,
                  "description": "curtain-wall bay only: opaque band at the top of the opening, covering the slab of the floor above from under it"
                },
                "spandrel": {
                  "type": "number",
                  "minimum": 0,
                  "description": "curtain-wall bay only: opaque band at the bottom of the opening, over the floor line; vision glass runs from sill + spandrel up to the head band"
                },
                "panes": {
                  "type": "object",
                  "required": ["cols", "rows"],
                  "additionalProperties": false,
                  "properties": {
                    "cols": { "type": "integer", "minimum": 1 },
                    "rows": { "type": "integer", "minimum": 1 }
                  },
                  "description": "mullion grid of a glazed opening; every pane is within the tier's structural pane limit"
                },
                "balcony": {
                  "type": "object",
                  "required": ["depth", "width", "bandId"],
                  "additionalProperties": false,
                  "properties": {
                    "depth": { "type": "number", "minimum": 0, "description": "0 = juliet railing" },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "bandId": { "type": "string", "minLength": 1, "description": "balconyBands id carrying this access door" }
                  },
                  "description": "present exactly when kind = balconyDoor; points to the shared band carrying this access"
                },
                "material": { "type": "string", "description": "theme/kind/tier key of the fill (glass, door leaf)" }
              }
            }
          }
        }
      }
    },
    "balconyBands": {
      "type": "array",
      "default": [],
      "description": "shared balcony slabs and rails; one band may serve several doors without duplicated geometry",
      "items": {
        "type": "object",
        "required": ["id", "floor", "edge", "offset", "width", "depth", "slabThickness", "railHeight", "style", "doors"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "floor": { "type": "integer", "minimum": 1 },
          "edge": { "type": "integer", "minimum": 0 },
          "offset": { "type": "number", "minimum": 0 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "depth": { "type": "number", "minimum": 0 },
          "slabThickness": { "type": "number", "minimum": 0 },
          "railHeight": { "type": "number", "exclusiveMinimum": 0 },
          "style": { "enum": ["bay", "full", "juliet"] },
          "doors": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "anchors": {
      "type": "array",
      "default": [],
      "description": "wire-anchor apertures: no hole; GLB node anchor:<id> sits at the attach point and carries the mount plate",
      "items": {
        "type": "object",
        "required": ["id", "position", "normal"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "request aperture id" },
          "position": { "$ref": "#/$defs/point3" },
          "normal": { "$ref": "#/$defs/point2" }
        }
      }
    },
    "signage": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["mode", "edge", "center", "width", "height", "standoff", "normal"],
        "additionalProperties": false,
        "properties": {
          "mode": { "enum": ["marquee", "logo"] },
          "edge": { "type": "integer", "minimum": 0, "description": "ground outline edge the sign is mounted on" },
          "orientation": {
            "enum": ["horizontal", "vertical"],
            "description": "marquee only: a band over the entrance, or a blade sign protruding edge-on from the facade"
          },
          "text": { "type": "string", "description": "marquee only" },
          "ratio": { "enum": ["1:1", "3:2", "16:9"], "description": "logo only" },
          "cellSize": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "marquee only: one letter cell in meters; an N-letter text takes N cells along the orientation"
          },
          "letterHeight": { "type": "number", "exclusiveMinimum": 0, "description": "marquee only: glyph height inside its cell" },
          "glyphCase": {
            "type": "object",
            "required": ["size", "depth", "inset"],
            "additionalProperties": false,
            "description": "marquee only: fitted metal case around every non-blank luminous glyph",
            "properties": {
              "size": { "type": "number", "exclusiveMinimum": 0 },
              "depth": { "type": "number", "exclusiveMinimum": 0 },
              "inset": { "type": "number", "minimum": 0 }
            }
          },
          "center": { "$ref": "#/$defs/point3" },
          "width": { "type": "number", "exclusiveMinimum": 0, "description": "extent along the facade" },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "depth": { "type": "number", "minimum": 0, "description": "how far the front face stands out from the wall" },
          "standoff": { "type": "number", "minimum": 0, "description": "where the back plane sits: 0 on clear wall, otherwise past the deepest relief or glazing it crosses" },
          "normal": { "$ref": "#/$defs/point2", "description": "[x, z] outward normal of the carrying face" }
        }
      }
    },
    "screens": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["edge", "center", "width", "height", "standoff", "normal"],
        "additionalProperties": false,
        "properties": {
          "edge": { "type": "integer", "minimum": 0, "description": "ground outline edge the screen is mounted on" },
          "center": { "$ref": "#/$defs/point3" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "standoff": { "type": "number", "minimum": 0, "description": "where the back plane sits: 0 on clear wall, otherwise past the deepest relief or glazing it crosses" },
          "normal": { "$ref": "#/$defs/point2" }
        }
      }
    },
    "lights": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["kind", "edge", "position", "normal", "size", "standoff"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["entrance", "accent"] },
          "edge": { "type": "integer", "minimum": 0, "description": "carrying ground-outline edge" },
          "position": { "$ref": "#/$defs/point3", "description": "centre of the rear mounting face on the facade plane" },
          "normal": { "$ref": "#/$defs/point2", "description": "unit outward direction of the luminous face" },
          "size": { "$ref": "#/$defs/point3", "description": "fixture width, height and outward depth" },
          "standoff": { "type": "number", "minimum": 0, "description": "distance from wall plane to rear mounting face; equals crossed facade relief depth for a flush mount" }
        }
      }
    },
    "facade": {
      "type": "object",
      "required": ["style", "panelModule", "wallDepth", "slabBand", "grids"],
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": ["megablock", "panel", "glass", "curtain-wall"],
          "description": "facade style: megablock (poor), panel (mid), glass (rich, high_rich), curtain-wall (offices and corpo at rich and high_rich)"
        },
        "panelModule": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "preferred concrete panel pitch in meters; grids publishes the exact fitted pitch used on each face"
        },
        "wallDepth": {
          "type": "number",
          "minimum": 0,
          "description": "meters the deepest opening unit reaches inward from the outline skin (window reveals, frames, glass and curtain panels, door reveals and closed leaves, aperture collars), measured on the built geometry; a consumer fitting the shell keeps everything it builds at least this far inside the outline"
        },
        "slabBand": {
          "type": "object",
          "required": ["below", "above"],
          "additionalProperties": false,
          "description": "the opaque band the facade keeps at every floor line, so an interior slab never reads through the glass: `below` metres under the walking surface and `above` metres over it",
          "properties": {
            "below": { "type": "number", "minimum": 0 },
            "above": { "type": "number", "minimum": 0 }
          }
        },
        "grids": {
          "type": "array",
          "description": "one entry per floor face: exact map-panel seams, opening-free wall runs and the seats where an interior partition may meet the facade without crossing glazing",
          "items": {
            "type": "object",
            "required": ["floor", "edge", "length", "panelWidth", "panelHeight", "horizontal", "vertical", "solid", "partitionAnchors"],
            "additionalProperties": false,
            "properties": {
              "floor": { "type": "integer" },
              "edge": { "type": "integer", "minimum": 0 },
              "length": { "type": "number", "exclusiveMinimum": 0 },
              "panelWidth": { "type": "number", "exclusiveMinimum": 0 },
              "panelHeight": { "type": "number", "exclusiveMinimum": 0 },
              "horizontal": {
                "type": "array", "minItems": 2, "items": { "type": "number", "minimum": 0 },
                "description": "panel seam offsets along the face, including 0 and length"
              },
              "vertical": {
                "type": "array", "minItems": 2, "items": { "type": "number", "minimum": 0 },
                "description": "panel seam offsets above this floor, including 0 and floor height"
              },
              "solid": {
                "type": "array", "items": { "$ref": "#/$defs/span" },
                "description": "maximal opening-free wall runs [start, end] along this face"
              },
              "partitionAnchors": {
                "type": "array",
                "description": "centres and available widths of solid runs at least 0.15 m wide",
                "items": {
                  "type": "object", "required": ["offset", "width"], "additionalProperties": false,
                  "properties": {
                    "offset": { "type": "number", "minimum": 0 },
                    "width": { "type": "number", "minimum": 0.15 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "facadeArtifacts": {
      "type": "array",
      "default": [],
      "description": "surface-mounted equipment, positioned like an opening: utility boxes, and condenser units in clusters of two to four on one floor and edge",
      "items": {
        "type": "object",
        "required": ["kind", "floor", "edge", "offset", "sill", "size"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["utility-box", "ac-unit"] },
          "floor": { "type": "integer" },
          "edge": { "type": "integer", "minimum": 0 },
          "offset": { "type": "number", "minimum": 0 },
          "sill": { "type": "number", "minimum": 0 },
          "size": { "$ref": "#/$defs/point3", "description": "[width, height, depth] in meters" },
          "standoff": { "type": "number", "minimum": 0, "default": 0, "description": "where the back of the housing sits, when it has to clear relief under it" }
        }
      }
    },
    "fireEscape": {
      "type": ["object", "null"],
      "default": null,
      "required": ["edge", "fromFloor", "toFloor", "offset", "width"],
      "additionalProperties": false,
      "properties": {
        "edge": { "type": "integer", "minimum": 0, "description": "ground outline edge it hangs on" },
        "fromFloor": { "type": "integer" },
        "toFloor": { "type": "integer" },
        "offset": { "type": "number", "minimum": 0, "description": "u of the platform stack's left edge along that edge" },
        "width": { "type": "number", "minimum": 0, "description": "platform length along the edge" }
      }
    },
    "roof": {
      "type": "object",
      "required": ["elevation", "outline", "parapetHeight", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "elevation": { "type": "number" },
        "outline": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point2" }
        },
        "parapetHeight": { "type": "number", "minimum": 0 },
        "bulkhead": {
          "type": ["object", "null"],
          "default": null,
          "required": ["center", "axis", "width", "depth", "housingHeight", "doorNormal", "doorWidth", "doorHeight"],
          "additionalProperties": false,
          "description": "stair-head cutout in the roof plane and the housing over it; null when the plate is too small for access plus its walk space",
          "properties": {
            "center": { "$ref": "#/$defs/point2" },
            "axis": { "$ref": "#/$defs/point2", "description": "unit vector along `width`; the cutout rectangle follows the plate's own axis" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "housingHeight": { "type": "number", "exclusiveMinimum": 0 },
            "doorNormal": { "$ref": "#/$defs/point2", "description": "outward normal of the housing face carrying the roof door" },
            "doorWidth": { "type": "number", "exclusiveMinimum": 0 },
            "doorHeight": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "center", "size", "rotationDeg"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["water-tank", "bulkhead", "hvac", "cooling-tower", "antenna", "dish", "solar", "helipad", "vent", "stack", "penthouse-screen", "pool", "bar"] },
              "center": { "$ref": "#/$defs/point2" },
              "size": {
                "type": "array",
                "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
                "minItems": 3,
                "maxItems": 3,
                "description": "[width, depth, height]"
              },
              "rotationDeg": { "type": "number", "description": "about +Y" }
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": { "type": "string" },
      "description": "every theme/kind/tier key used in the GLB, deduplicated, sorted"
    }
  },
  "$defs": {
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "point3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "maxItems": 3
    },
    "span": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
